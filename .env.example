# Copy to .env — values here are applied at server start unless already set in
# the environment.  Relative paths are resolved against the project root.
# Interpreter paths (*_RUNTIME) are optional: Dubline finds bin/python or
# Scripts\python.exe inside each vendor venv automatically.
DUB_ENGINE=indextts
DUB_WORKDIR=./data
# Server bind (run.sh / Linux). Use 127.0.0.1 to restrict to local access.
DUB_HOST=0.0.0.0
DUB_PORT=8000
# Optional: copy every finished dub (MKV, QC report, exports) into this folder
# (or a client-chosen subfolder of it) so remote jobs need no download step.
#DUB_DELIVERY_DIR=/mnt/media/dubline/output
INDEXTTS_REPO=./vendor/index-tts
INDEXTTS_MODEL_DIR=./vendor/index-tts/checkpoints
WHISPER_MODEL=turbo
WHISPER_CACHE_DIR=./vendor/whisper
BANDIT_REPO=./vendor/bandit-v2
BANDIT_CHECKPOINT=./vendor/bandit-v2/checkpoints/checkpoint-multi.ckpt
TRANSLATION_QC_MODEL=./vendor/qwen3-8b/Qwen3-8B-Q4_K_M.gguf
TRANSLATION_MODEL=./vendor/hy-mt2-7b/Hy-MT2-7B-Q4_K_M.gguf
QWEN_ASR_MODEL=./vendor/qwen3-asr-0.6b-qwen
QWEN_ASR_ESCALATION_MODEL=./vendor/qwen3-asr-1.7b-qwen
QWEN_ALIGNER_MODEL=./vendor/qwen3-forced-aligner-0.6b-qwen
#QWEN_ASR_RUNTIME=./vendor/pyannote-env
OPENCV_FACE_MODEL_DIR=./vendor/opencv-face
QWEN_TTS_MODEL=./vendor/qwen3-tts-1.7b-base
#QWEN_TTS_RUNTIME=./vendor/qwen-tts-env
# Qwen3-TTS cloning prompt: auto (xvector across languages, icl same language), icl, or xvector
QWEN_TTS_CLONE_MODE=auto
ROFORMER_MODEL_DIR=./vendor/melband-roformer/melband-roformer-kim-vocals
PYANNOTE_MODEL=./vendor/pyannote-community-1
#PYANNOTE_RUNTIME=./vendor/pyannote-env
MUSETALK_REPO=./vendor/MuseTalk
MUSETALK_MODEL_DIR=./vendor/MuseTalk/models/musetalkV15
#MUSETALK_RUNTIME=./vendor/musetalk-env
# Lip-sync engine: musetalk (fast, 9 GB) or latentsync (LatentSync 1.6: better sync/identity, 17.5 GB, 2x slower)
LIPSYNC_ENGINE=latentsync
# Lip-sync every utterance with a clean, visible single face (0 = no shot cap). Skipped shots keep the original picture.
# Requires ./setup.sh --with-musetalk (torch 2.8 cu128 build; runs on RTX 50-series).
MUSETALK_ENABLED=1
MUSETALK_MAX_SHOTS=0
DUB_DIARIZATION_DEVICE=cuda
DUB_LLAMA_GPU_LAYERS=-1
HF_TOKEN=
